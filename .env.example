# Copy to .env and fill in. Never commit .env.

# --- LLM provider: ollama (default: local and free) or openai ---
LLM_PROVIDER=ollama
# Any Ollama model with tool-calling support. See `ollama list`, or run `ollama pull llama3.1`.
LLM_MODEL=llama3.1
LLM_TEMPERATURE=0

# ollama provider. Inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens sent to Ollama (num_ctx). Unset = the server's default, often 4,096,
# which two or three ranking answers fill; Ollama then silently drops the oldest messages.
# The agent logs a warning when a prompt reaches about 80% of this value. 16384 suits 8-20B models.
# OLLAMA_NUM_CTX=16384

# --- OpenAI (infrastructure ready, disabled by default) ---
# To use it: set LLM_PROVIDER=openai, set LLM_MODEL (for example gpt-4o-mini) and uncomment the key.
# OPENAI_API_KEY=
# Optional: any OpenAI-compatible server (LM Studio, vLLM, Ollama /v1). Leave unset for api.openai.com.
# LLM_BASE_URL=

# --- Data (used by ingest only, never at chat time) ---
CENSUS_API_KEY=

# --- Paths (relative to the project root) ---
DB_PATH=data/airport.db
# Gzipped seed DB written by `uv run python -m src.seed build` (with a .sha256 next to it); not committed.
SEED_DB_PATH=data/seed/airport.db.gz
# The build stops if the compressed seed is larger than this (GitHub Release assets should stay small).
SEED_MAX_MB=50
RAW_DATA_DIR=data/raw
WEIGHTS_PATH=config/weights.yaml

# --- Agent ---
# Longest question accepted (characters); longer input is rejected before reaching the model.
MAX_INPUT_CHARS=2000

LOG_LEVEL=INFO

# --- Upstream endpoints (ingest only; defaults in src/config.py, override only if they move) ---
# CENSUS_API_URL=https://api.census.gov/data
# CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/geographies/coordinates
# ONTIME_PREZIP_URL=https://transtats.bts.gov/PREZIP/On_Time_Reporting_Carrier_On_Time_Performance_1987_present_{year}_{month}.zip
# T100_PAGE_URL=https://www.transtats.bts.gov/DL_SelectFields.aspx?gnoyr_VQ=FMG&QO_fu146_anzr=Nv4%20Pn44vr45
# Seconds per HTTP request, and the pause between Census Geocoder requests (polite rate limit).
HTTP_TIMEOUT_S=30
GEOCODER_DELAY_S=0.25

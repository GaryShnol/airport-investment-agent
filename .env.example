# Copy to .env and fill in. Never commit .env.

# --- LLM provider: openai | ollama ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# openai provider
OPENAI_API_KEY=
# Optional: any OpenAI-compatible server (Ollama /v1, LM Studio, vLLM). Leave empty for api.openai.com
LLM_BASE_URL=

# ollama provider (local model). Inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- Data (used by ingest only, never at chat time) ---
CENSUS_API_KEY=

# --- Paths (relative to the project root) ---
DB_PATH=data/airport.db
SEED_DB_PATH=seed/airport.db
RAW_DATA_DIR=data/raw
WEIGHTS_PATH=config/weights.yaml

LOG_LEVEL=INFO

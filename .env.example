# Copy to .env and fill in. Never commit .env.

# --- LLM: OpenAI by default (reviewer quickstart: paste the key below, then `docker compose up`) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
OPENAI_API_KEY=
# Model server URL, for either provider. Unset = api.openai.com for openai, OLLAMA_BASE_URL for ollama.
# LLM_BASE_URL=

# --- Optional: a local model with Ollama instead (see the README, "Local model") ---
# Run Ollama on the host and `ollama pull <model>` there (models come from the Ollama registry, not the image).
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# From Docker: http://host.docker.internal:11434; from a local `uv run`: http://localhost:11434
# LLM_BASE_URL=http://host.docker.internal:11434
# Context window in tokens sent to Ollama (num_ctx). Unset = the server's default, often 4,096,
# which two or three ranking answers fill; Ollama then silently drops the oldest messages.
# The agent logs a warning when a prompt reaches about 80% of this value. 16384 suits 8-20B models.
# OLLAMA_NUM_CTX=16384
# Older name for the Ollama URL, used when LLM_BASE_URL is unset (default http://localhost:11434).
# OLLAMA_BASE_URL=http://localhost:11434

# --- Data (used by ingest only, never at chat time) ---
CENSUS_API_KEY=

# --- Paths (relative to the project root) ---
DB_PATH=data/airport.db
# Gzipped seed DB written by `uv run python -m src.seed build` (with a .sha256 next to it); not committed.
SEED_DB_PATH=data/seed/airport.db.gz
# The build stops if the compressed seed is larger than this (GitHub Release assets should stay small).
SEED_MAX_MB=50

# --- Bootstrap (container start: `python -m src.bootstrap`) ---
# If DB_PATH is missing or invalid, the seed DB is downloaded from here, checked and installed.
SEED_DB_URL=https://github.com/GaryShnol/airport-investment-agent/releases/download/data-2025/airport.db.gz
# Expected sha256 of the seed. Unset = read it from SEED_DB_URL + ".sha256".
# SEED_DB_SHA256=
# Seconds per request for the freshness check (ingest --check) run at startup; failure = "unknown".
BOOTSTRAP_CHECK_TIMEOUT_S=5
# Streamlit port (inside the container and published on the host by docker compose).
APP_PORT=8501
RAW_DATA_DIR=data/raw
WEIGHTS_PATH=config/weights.yaml

# --- Agent ---
# Longest question accepted (characters); longer input is rejected before reaching the model.
MAX_INPUT_CHARS=2000

# --- Voice input (app only; see the README, "Voice") ---
# The microphone is shown when LLM_PROVIDER=openai with OPENAI_API_KEY, or when STT_BASE_URL is set.
# Recordings go to the OpenAI audio transcription API only when the user records; nothing is stored.
STT_MODEL=gpt-4o-mini-transcribe
# Longest recording accepted, in seconds (checked before anything is sent).
STT_MAX_SECONDS=60
# A separate OpenAI-compatible transcription server (e.g. a local Whisper server; set STT_MODEL to its model).
# Unset = LLM_BASE_URL when LLM_PROVIDER=openai, else api.openai.com.
# STT_BASE_URL=

LOG_LEVEL=INFO

# --- Upstream endpoints (ingest only; defaults in src/config.py, override only if they move) ---
# CENSUS_API_URL=https://api.census.gov/data
# CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/geographies/coordinates
# ONTIME_PREZIP_URL=https://transtats.bts.gov/PREZIP/On_Time_Reporting_Carrier_On_Time_Performance_1987_present_{year}_{month}.zip
# T100_PAGE_URL=https://www.transtats.bts.gov/DL_SelectFields.aspx?gnoyr_VQ=FMG&QO_fu146_anzr=Nv4%20Pn44vr45
# Seconds per HTTP request, and the pause between Census Geocoder requests (polite rate limit).
HTTP_TIMEOUT_S=30
GEOCODER_DELAY_S=0.25
# `ingest --update` downloads (one request at a time): seconds per request, pause before each request
# after the first, extra attempts after a network error or a 5xx answer (never after a 404).
DOWNLOAD_TIMEOUT_S=120
DOWNLOAD_DELAY_S=2
DOWNLOAD_RETRIES=2
# HTTP_USER_AGENT=airport-investment-agent/1.0 (offline data refresh; https://github.com/GaryShnol/airport-investment-agent)
# Upstream file formats for `ingest --update` (PREZIP column mapping, T-100 form fields, size estimates).
# SOURCES_PATH=config/sources.yaml
